    "@tauri-apps/plugin-store": "^2.0.0",
    "docx": "^9.5.1",
    "fflate": "^0.8.2",
    "github-slugger": "^2.0.0",
    "katex": "^0.16.0",
    "lucide-react": "^0.300.0",
    "mermaid": "^11.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
