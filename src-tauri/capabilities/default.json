{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Capability for the main Markdown reader window",
  "windows": ["main", "markdown-quick-preview"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-exists",
    "fs:allow-rename",
    "fs:allow-watch",
    "fs:allow-unwatch",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "store:allow-load"
  ]
}
